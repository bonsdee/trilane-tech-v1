# Copy to .env.local for local development. Values are baked into the build,
# so never put secrets here.

# Base address of the backend API, including /api/v1.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Public address of the site; used for the sitemap, robots file and sharing tags.
VITE_SITE_URL=http://localhost:5173

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable.
# Analytics loads only after a visitor accepts the cookie banner.
VITE_GA_MEASUREMENT_ID=
