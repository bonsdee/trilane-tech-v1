# Copy this file to .env and fill in the values.
# docker-compose.yml and the backend (when run from backend/ or this folder)
# both read .env. Never commit .env.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/trilane
DB_USERNAME=trilane
# Any long random string for local use. In production, use the managed database's password.
DB_PASSWORD=change-me-local-db-password

# --- Sign-in tokens -----------------------------------------------------------
# At least 32 random characters. Generate one with:  openssl rand -base64 48
# Optional in development (a temporary one is generated per run, which signs
# everyone out on restart). Required in production.
JWT_SECRET=

# --- Website address ------------------------------------------------------------
# Used in email links and as the allowed browser origin.
SITE_URL=http://localhost:5173
# Optional: comma-separated list if more than one origin should be allowed.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Manila

# --- First admin (used once, when no accounts exist) ------------------------------
ADMIN_EMAIL=jivonzdy@trilanetech.com
ADMIN_NAME=Jivonz

# --- Email ------------------------------------------------------------------------
# Local development uses Mailpit from docker-compose (view mail at http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=Trilane Tech <jivonzdy@trilanetech.com>
# Comma-separated. Receives a notification for every new lead.
LEAD_NOTIFICATION_TO=jivonzdy@trilanetech.com
#
# Production with Google Workspace (see documentation/SETUP_GUIDE.md):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=jivonzdy@trilanetech.com
# MAIL_PASSWORD=<16-character app password>
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# --- Uploaded images ---------------------------------------------------------------
# Folder for uploaded images. In production, point this at the persistent disk.
UPLOAD_DIR=./uploads

# --- Production only ----------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod
# AUTH_COOKIE_SECURE=true
